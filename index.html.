er;object-fit:cover;flex-shrink:0}.field{display:flex;flex-direction:column;gap:5px;margin:12px 0}label{font-size:12px;color:var(--m);font-weight:750}input,textarea,select{width:100%;background:#171719;color:var(--t);border:1px solid #41414a;border-radius:9px;padding:11px}textarea{min-height:80px}.grid2,.details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.info b{display:block;overflow-wrap:anywhere}.modalback,.shade{position:fixed;inset:0;background:#000b;z-index:20;display:grid;place-items:center;padding:14px;animation:fade .18s}.modal{width:min(660px,100%);max-height:92vh;overflow:auto;background:var(--p);border:1px solid #51446d;border-radius:17px;padding:18px;animation:pop .18s}.modalhead,.head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}.drawer{position:fixed;z-index:22;top:0;right:0;bottom:0;width:min(390px,88vw);height:100dvh;background:var(--p);border-left:1px solid #51446d;padding:18px;display:flex;flex-direction:column;overflow:auto;animation:slide .24s}.drawerback{position:fixed;inset:0;background:#0009;z-index:21;animation:fade .18s}.draweruser{text-align:center;padding:18px}.draweruser .avatar{width:76px;height:76px;margin:0 auto 9px}.drawerlinks{display:grid;gap:8px}.drawerlinks button{text-align:left;background:var(--p2);color:var(--t);border:1px solid var(--b);border-radius:10px;padding:12px}.bottom{margin-top:auto;padding-top:20px}.detailcover{width:100%;max-height:280px;aspect-ratio:16/9;object-fit:cover;border-radius:12px;background:#303035}.video{width:100%;aspect-ratio:16/9;border:0;border-radius:12px;background:#080808}.notice{font-size:12px;color:var(--m);padding:11px;background:#19191c;border:1px solid var(--b);border-radius:10px;margin:12px 0}.badge{display:inline-block;border:1px solid #65518d;color:var(--a);padding:3px 8px;border-radius:20px;font-size:11px;font-weight:800}.toast{position:fixed;z-index:50;bottom:16px;left:50%;transform:translateX(-50%);background:#30283d;border:1px solid #65518d;padding:11px 15px;border-radius:10px;max-width:90%}footer{text-align:center;color:var(--m);font-size:12px;margin-top:25px}@keyframes slide{from{transform:translateX(100%)}to{transform:translateX(0)}}@keyframes fade{from{opacity:0}to{opacity:1}}@keyframes pop{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}@media(max-width:620px){.grid2,.details{grid-template-columns:1fr}.hero,.panel{padding:15px}.metrics{grid-template-columns:repeat(2,1fr)}.cover{width:96px;min-height:92px;height:auto}.demonrow .pos{min-width:34px;padding:8px 5px}.demonrow .grow{padding:9px 8px 9px 0}.stats{gap:6px}.stat{padding:9px}.stat b{font-size:19px}}
