function detail(did){let d=db.demons.find(x=>x.id===did);if(!d)return;let video=embed(d.verify),orig=d.list==='legacy'?`<div class="info"><span>Top original</span><b>${esc((d.originalList?LISTS[d.originalList].name+' ':'')+'#'+(d.originalTop||'—'))}</b></div><div class="info"><span>Top legacy</span><b>#${d.top}</b></div>`:'';modal(d.name,`${d.cover?`<img class="detailcover" src="${d.cover}" alt="Portada">`:''}<p style="margin-top:12px"><span class="badge">${LISTS[d.list].name.toUpperCase()}${d.list==='unlist'?' · SIN VERIFICAR':' · TOP '+d.top}</span></p><div class="details"><div class="info"><span>Su verificador</span><b>${esc(d.verifier||'Sin especificar')}</b></div><div class="info"><span>El creador</span><b>${esc(d.creator||'Sin especificar')}</b></div><div class="info"><span>Top actual</span><b>${d.list==='legacy'?'Legacy #'+d.top:'#'+d.top}</b></div><div class="info"><span>Song</span><b>${esc(d.song||'Sin especificar')}</b></div><div class="info"><span>ID</span><b>${esc(d.levelId||'Sin especificar')}</b></div>${orig}</div>${d.description?`<p>${esc(d.description)}</p>`:''}<hr><h3>Video de verificación</h3>${video?`<iframe class="video" src="${video}" title="Video de verificación" allowfullscreen></iframe>`:''}${d.verify?`<p><a class="link" href="${esc(d.verify)}" target="_blank" rel="noopener">↗ Abrir enlace de verificación</a></p>`:'<p class="muted small">Sin enlace de verificación.</p>'}${admin()?`<button class="btn primary" id="editFromDetail">Editar demon</button>${d.list==='unlist'?'<button class="btn" id="verifyFromDetail">Marcar como verificado</button>':''}`:''}`);if(admin())$('editFromDetail').onclick=()=>editDemon(d.id);if(admin()&&$('verifyFromDetail'))$('verifyFromDetail').onclick=()=>{list='main';moveDemon(d.id)}}
function renderAdmin(){if(!admin())return;let c=$('adminContent');$('adminStats').innerHTML=`<div class="stat"><b>${db.subs.filter(s=>s.status==='Pendiente').length}</b><span>Envíos pendientes</span></div><div class="stat"><b>${db.demons.filter(d=>!d.archived).length}</b><span>Demons activos</span></div><div class="stat"><b>${db.users.length}</b><span>Jugadores</span></div>`;document.querySelectorAll('[data-admin]').forEach(b=>b.classList.toggle('active',b.dataset.admin===adminTab));if(adminTab==='demons'){c.innerHTML=`<div class="head"><h3>Administrar demons</h3><button class="btn primary" id="addDemon">＋ Agregar demon</button></div><div class="field"><label>Lista a administrar</label><select id="adminList">${Object.entries(LISTS).map(([k,v])=>`<option value="${k}" ${k===list?'selected':''}>${v.name} (${v.limit})</option>`).join('')}</select></div>${Object.keys(LISTS).map(k=>`<div class="notice">${LISTS[k].name}: ${active(k).length}/${LISTS[k].limit}</div>`).join('')}<div id="adminRows"></div>`;$('addDemon').onclick=()=>editDemon();$('adminList').onchange=e=>{list=e.target.value;renderLists();renderAdmin()};let a=active(list);$('adminRows').innerHTML=a.length?a.map(d=>`<div class="row">${d.cover?`<img class="cover" src="${d.cover}">`:''}<b class="pos">#${d.top}</b><div class="grow"><b>${esc(d.name)}</b><small>${esc(d.creator||'—')}</small><div class="actions"><button class="btn" data-edit="${d.id}">Editar</button><button class="btn" data-move="${d.id}">Mover</button><button class="btn" data-archive="${d.id}">Archivar</button><button class="btn" data-delete="${d.id}">Eliminar</button></div></div></div>`).join(''):'<div class="empty">Esta lista está vacía.</div>';c.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editDemon(b.dataset.edit));c.querySelectorAll('[data-move]').forEach(b=>b.onclick=()=>moveDemon(b.dataset.move));c.querySelectorAll('[data-archive]').forEach(b=>b.onclick=()=>{let d=db.demons.find(x=>x.id===b.dataset.archive);if(confirm('¿Archivar '+d.name+' y conservar su historial?')){d.archived=true;renumber(list);log('Archivó demon',d.name);save()}});c.querySelectorAll('[data-delete]').forEach(b=>b.onclick=()=>{let d=db.demons.find(x=>x.id===b.dataset.delete);if(confirm('¿Eliminar definitivamente '+d.name+'?')){db.demons=db.demons.filter(x=>x.id!==d.id);renumber(list);log('Eliminó demon',d.name);save()}})}else if(adminTab==='records'){let a=db.subs.filter(s=>s.status==='Pendiente');c.innerHTML='<h3>Submit Records pendientes</h3>'+(a.length?a.map(s=>`<div class="row demonrow">${s.cover?`<img class="cover" src="${s.cover}" alt="Portada del nivel">`:'<div class="cover placeholder">◈</div>'}<div class="grow"><b>${esc(s.name)} · Top ${s.top}</b><small>Jugador: ${esc(s.player)} · ${fmt(s.at)}</small><p>${esc(s.comment||'Sin comentario')}</p><a class="link" href="${esc(s.url)}" target="_blank">Abrir verificación</a><div class="actions"><button class="btn primary" data-review="${s.id}" data-status="Aprobado">Aprobar</button><button class="btn" data-review="${s.id}" data-status="Rechazado">Rechazar</button></div></div></div>`).join(''):'<div class="empty">No hay envíos pendientes.</div>');c.querySelectorAll('[data-review]').forEach(b=>b.onclick=()=>review(b.dataset.review,b.dataset.status))}else if(adminTab==='players'){c.innerHTML='<h3>Gestionar jugadores</h3>'+db.users.map(u=>`<div class="row">${img(u)}<div class="grow"><b>${esc(u.display||u.username)}</b><small>${u.points||0} pts · ${esc(u.hardest||'Sin Hardest')}</small><div class="actions"><button class="btn" data-stats="${u.id}">Editar puntos</button><button class="btn" data-hide="${u.id}">${u.hidden?'Restaurar Top':'Quitar del Top'}</button><button class="btn" data-suspend="${u.id}">${u.suspended?'Reactivar':'Suspender'}</button></div></div></div>`).join('');c.querySelectorAll('[data-stats]').forEach(b=>b.onclick=()=>editStats(b.dataset.stats));c.querySelectorAll('[data-hide]').forEach(b=>b.onclick=()=>{let u=db.users.find(x=>x.id===b.dataset.hide);u.hidden=!u.hidden;log(u.hidden?'Quitó jugador del Top':'Restauró jugador al Top',u.username);save()});c.querySelectorAll('[data-suspend]').forEach(b=>b.onclick=()=>{let u=db.users.find(x=>x.id===b.dataset.suspend);if(u.id===me().id)return toast('No podés suspenderte.');u.suspended=!u.suspended;log(u.suspended?'Suspendió jugador':'Reactivó jugador',u.username);save()})}else c.innerHTML='<h3>Activity Log</h3>'+(db.log.length?db.log.map(x=>`<div class="row"><div class="grow"><b>${esc(x.action)} · ${esc(x.target)}</b><small>${fmt(x.at)} · @${esc(x.by)}</small><p class="small">${esc(x.details)}</p></div></div>`).join(''):'<div class="empty">Todavía no hay actividad.</div>')}
function editDemon(did=null){if(!admin())return;let d=db.demons.find(x=>x.id===did)||{name:'',top:active(list).length+1,list,creator:'',verifier:'',song:'',levelId:'',verify:'',cover:'',description:'',difficulty:'Extreme Demon',originalTop:'',originalList:'',uploaderId:me()?.id||'',uploaderName:me()?.display||me()?.username||'Moderación'};modal(did?'Editar demon':'Agregar demon',`<form id="demonForm"><div class="field"><label>Lista</label><select id="dl">${Object.entries(LISTS).map(([k,v])=>`<option value="${k}" ${d.list===k?'selected':''}>${v.name} (máx. ${v.limit})</option>`).join('')}</select></div><div class="grid2"><div class="field"><label>Top actual</label><input id="dt" type="number" min="1" required value="${d.top}"></div><div class="field"><label>Nombre del demon</label><input id="dn" maxlength="100" required value="${esc(d.name)}"></div><div class="field"><label>Su verificador</label><input id="dv" maxlength="100" value="${esc(d.verifier)}"></div><div class="field"><label>El creador</label><input id="dc" maxlength="100" value="${esc(d.creator)}"></div><div class="field"><label>Song</label><input id="ds" maxlength="160" value="${esc(d.song)}"></div><div class="field"><label>ID de Geometry Dash</label><input id="di" maxlength="60" value="${esc(d.levelId)}"></div></div><div class="field"><label>Link de verificación</label><input id="du" type="url" value="${esc(d.verify)}" placeholder="https://youtube.com/..."></div><div class="field"><label>Portada del demon</label><input id="df" type="file" accept="image/*"><small class="muted">Imagen de menos de 650 KB.</small>${d.cover?`<img class="detailcover" src="${d.cover}" alt="Portada actual"> <label><input id="delCover" type="checkbox" style="width:auto"> Quitar portada</label>`:''}</div><div class="field"><label>Descripción adicional</label><textarea id="dd">${esc(d.description)}</textarea></div><div id="legacyFields" class="${d.list==='legacy'?'':'hidden'}"><div class="grid2"><div class="field"><label>Top original</label><input id="ot" type="number" min="1" value="${d.originalTop||''}"></div><div class="field"><label>Lista original</label><select id="ol"><option value="">No especificada</option><option value="main" ${d.originalList==='main'?'selected':''}>Main List</option><option value="extended" ${d.originalList==='extended'?'selected':''}>Extended List</option></select></div></div><p class="muted small">Top original conserva lista y puesto previos. Top legacy es la posición actual.</p></div><button class="btn primary">Guardar demon</button></form>`);$('dl').onchange=()=>{$('legacyFields').classList.toggle('hidden',$('dl').value!=='legacy');$('dt').max=LISTS[$('dl').value].limit};$('demonForm').onsubmit=async e=>{e.preventDefault();let dest=$('dl').value,cap=LISTS[dest].limit,top=Number($('dt').value);if(top<1||top>cap)return toast(`La posición debe estar entre 1 y ${cap}.`);if(!did&&active(dest).length>=cap)return toast(`${LISTS[dest].name} está llena.`);let f=$('df').files[0],cover=d.cover||'';if(f){if(f.size>650000)return toast('La portada debe pesar menos de 650 KB.');cover=await readImage(f)}if($('delCover')?.checked)cover='';let old=d.list;Object.assign(d,{name:$('dn').value.trim(),list:dest,top,uploaderId:d.uploaderId||me()?.id||'',uploaderName:d.uploaderName||me()?.display||me()?.username||'Moderación',verifier:$('dv').value.trim(),creator:$('dc').value.trim(),song:$('ds').value.trim(),levelId:$('di').value.trim(),verify:$('du').value.trim(),cover,description:$('dd').value.trim(),difficulty:'Extreme Demon',archived:false});if(dest==='unlist'){d.top=active('unlist').length+1;d.difficulty='Sin verificar'}if(dest==='legacy'){d.originalTop=Number($('ot')?.value)||d.originalTop||'';d.originalList=$('ol')?.value||d.originalList||''}if(!did){d.id=id();db.demons.push(d)}if(old!==dest)renumber(old);renumber(dest);log(did?'Editó demon':'Agregó demon',d.name,LISTS[dest].name+(dest==='unlist'?'':' #'+d.top));list=dest;save();closeModal();toast('Demon guardado.')}}
function moveDemon(did){let d=db.demons.find(x=>x.id===did);modal('Mover demon',`<form id="moveForm"><p>Mover <b>${esc(d.name)}</b> a otra lista.</p><div class="field"><label>Destino</label><select id="md">${Object.entries(LISTS).filter(([k])=>k!==d.list).map(([k,v])=>`<option value="${k}">${v.name}</option>`).join('')}</select></div><div class="field"><label>Top original si pasa a Legacy</label><input id="mo" type="number" min="1" value="${d.originalTop||d.top}"></div><button class="btn primary">Mover demon</button></form>`);$('moveForm').onsubmit=e=>{e.preventDefault();let old=d.list,dest=$('md').value;if(active(dest).length>=LISTS[dest].limit)return toast('La lista de destino está llena.');if(dest==='legacy'){d.originalList=old;d.originalTop=Number($('mo').value)||d.top}d.list=dest;d.top=active(dest).length+1;renumber(old);log('Movió demon',d.name,LISTS[old].name+' → '+LISTS[dest].name);list=dest;save();closeModal()}}
function review(sid,status){let s=db.subs.find(x=>x.id===sid);if(!s)return;if(status==='Aprobado'){let existing=db.demons.find(d=>d.name.toLowerCase()===s.name.toLowerCase()&&!d.archived),dest=s.top<=150?'main':s.top<=450?'extended':'legacy';if(existing&&existing.list==='unlist'){if(active(dest).length<LISTS[dest].limit){existing.list=dest;existing.top=active(dest).length;existing.verify=s.url;existing.verifier=s.player;existing.cover=existing.cover||s.cover||'';existing.difficulty='Extreme Demon';renumber(dest)}}else if(!existing){if(active(dest).length<LISTS[dest].limit)db.demons.push({id:id(),name:s.name,top:active(dest).length+1,list:dest,creator:s.player,verifier:s.player,song:'',levelId:'',verify:s.url,cover:s.cover||'',description:s.comment,difficulty:'Extreme Demon',archived:false,uploaderId:s.user,uploaderName:s.player})}let u=db.users.find(x=>x.id===s.user);if(u){u.points=(u.points||0)+Math.max(1,Math.round(100/Math.max(1,s.top)));if(!u.hardest)u.hardest=s.name}}s.status=status;if(status==='Rechazado'){const pendingLevel=db.demons.find(d=>d.id===s.id||d.name.toLowerCase()===s.name.toLowerCase()&&d.list==='unlist');if(pendingLevel){pendingLevel.archived=true;pendingLevel.submissionStatus='rejected'}}log(status==='Aprobado'?'Aprobó Submit Record':'Rechazó Submit Record',s.name);save();toast(status)}
function editStats(uid){let u=db.users.find(x=>x.id===uid);modal('Editar estadísticas',`<form id="statsForm"><div class="field"><label>Jugador</label><input disabled value="${esc(u.username)}"></div><div class="field"><label>Puntos</label><input id="pts" type="number" min="0" value="${u.points||0}"></div><div class="field"><label>Hardest</label><input id="hard" value="${esc(u.hardest||'')}"></div><div class="field"><label>Motivo</label><textarea id="reason"></textarea></div><button class="btn primary">Guardar</button></form>`);$('statsForm').onsubmit=e=>{e.preventDefault();u.points=Number($('pts').value);u.hardest=$('hard').value;log('Corrigió estadísticas',u.username,$('reason').value);save();closeModal()}}
$('subForm').onsubmit=e=>{e.preventDefault();let u=me(),url=$('subUrl').value,sel=$('subName'),did=sel.value,chosen=db.demons.find(d=>d.id===did),name=chosen?chosen.name:did==='__unlisted__'?(prompt('Nombre del nivel que todavía no está en la lista:')||'').trim():'';if(!name)return toast('Seleccioná un nivel o escribí el nombre del nivel no listado.');if(!/^https?:\/\/(www\.)?(youtube\.com|youtu\.be)\//i.test(url))return toast('Ingresá un enlace de YouTube válido.');let cover=chosen?.cover||'',top=Number($('subTop').value)||chosen?.top||1;let subId=chosen&&chosen.list!=='unlist'?id():id();db.subs.unshift({id:subId,user:u.id,player:$('subPlayer').value.trim(),top,name,levelId:chosen?.id||'',list:chosen?.list||'unlist',cover,url,comment:$('subComment').value.trim(),status:'Pendiente',at:now(),source:chosen&&chosen.list!=='unlist'?'record':'unlist'});if((!chosen||chosen.list==='unlist')&&name&&!db.demons.some(d=>d.name.toLowerCase()===name.toLowerCase()))db.demons.push({id:subId,name,top:active('unlist').length+1,list:'unlist',creator:'',verifier:'',song:'',levelId:'',verify:url,cover:cover||'',description:'Enviado por '+(u.display||u.username),difficulty:'Sin verificar',archived:false,uploaderId:u.id,uploaderName:u.display||u.username,submissionStatus:'pending'});log('Envió Submit Record',name,'Top '+top);e.target.reset();$('subPlayer').value=u.display||u.username;save();populateSubmitSelectors();mySubs();toast('Envío pendiente de revisión.')};
document.addEventListener('click',e=>{let p=e.target.closest('[data-page]');if(p){showPage(p.dataset.page);return}let l=e.target.closest('[data-list]');if(l){list=l.dataset.list;renderLists();return}let a=e.target.closest('[data-admin]');if(a){adminTab=a.dataset.admin;renderAdmin();return}let up=e.target.closest('[data-uploader]');if(up){let u=db.users.find(x=>x.id===up.dataset.uploader);if(u)modal(u.display||u.username,`${img(u)}<p>@${esc(u.username)}</p><p>${esc(u.bio||'Sin descripción')}</p><div class="metrics"><div class="metric"><span>Hardest</span><b>${esc(u.hardest||'Sin registrar')}</b></div><div class="metric"><span>Puntos</span><b>${u.points||0}</b></div></div>`);return}let d=e.target.closest('[data-detail]');if(d)detail(d.dataset.detail)});$('levelRows').addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.dataset.detail)detail(e.target.dataset.detail)});$('settings').onclick=openAccount;$('modalX').onclick=closeModal;$('modalBack').onclick=e=>{if(e.target===$('modalBack'))closeModal()};$('drawerX').onclick=closeDrawer;$('drawerBack').onclick=closeDrawer;document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeDrawer()}});bootstrap();
})();
</script></body></html>