<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(()=>{'use strict';
const KEY='obsidian_v4',THEME='obsidian_theme_v1',LISTS={main:{name:'Main List',limit:150},extended:{name:'Extended List',limit:300},legacy:{name:'Legacy List',limit:1000},unlist:{name:'Unlist',limit:1000}};
const SUPABASE_URL='https://hqdlnmdongkszlnmjjdb.supabase.co';
const SUPABASE_KEY='sb_publishable_mVFI0YvKBQV8cbvY4f0nBg_fkatg-7f';
const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
let db=blank(),uidSession='',list='main',adminTab='demons',authMode='login',authUser=null,currentIsAdmin=false,syncState=null,syncQueue=Promise.resolve();document.body.classList.toggle('light',localStorage.getItem(THEME)==='light');
const $=id=>document.getElementById(id),id=()=>uuid(),now=()=>new Date().toISOString(),fmt=x=>x?new Date(x).toLocaleDateString('es',{year:'numeric',month:'short',day:'numeric'}):'—',esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function blank(){return{users:[],demons:[],subs:[],log:[]}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(db))}catch{}render();syncQueue=syncQueue.then(syncChanges).catch(err=>{console.error('Supabase sync:',err);toast('No se pudo guardar en Supabase. Revisá tu sesión y los permisos.')})}
function me(){return db.users.find(u=>u.id===uidSession)||null}function admin(){return !!currentIsAdmin}
function clone(x){return JSON.parse(JSON.stringify(x))}function same(a,b){return JSON.stringify(a)===JSON.stringify(b)}
function statusIn(x){return x==='Aprobado'?'approved':x==='Rechazado'?'rejected':'pending'}function statusOut(x){return x==='approved'?'Aprobado':x==='rejected'?'Rechazado':'Pendiente'}
function uuid(){return (crypto&&crypto.randomUUID)?crypto.randomUUID():'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.random()*16|0;return(c==='x'?r:(r&3|8)).toString(16)})}
async function checkAdmin(){if(!uidSession){currentIsAdmin=false;return false}const {data,error}=await sb.rpc('is_current_user_admin');currentIsAdmin=!error&&data===true;return currentIsAdmin}
async function ensureProfile(user){if(!user)return;uidSession=user.id;authUser=user;const {data,error}=await sb.from('profiles').select('id').eq('id',user.id).maybeSingle();if(error)throw error;if(!data){const username=String(user.user_metadata?.username||user.email?.split('@')[0]||'player').slice(0,24);const r=await sb.from('profiles').insert({id:user.id,username,description:'',avatar_url:null});if(r.error&&r.error.code!=='23505')throw r.error}}
async function loadRemote(){
 const {data:sessionData}=await sb.auth.getSession();authUser=sessionData?.session?.user||authUser;uidSession=authUser?.id||'';await checkAdmin();
 const safeQuery=async q=>{const r=await q; if(r.error){console.warn('Supabase read:',r.error.message);return []}return r.data||[]};
 const [profiles,stats,levelRows,recordRows,unlistRows,activityRows,moderationRows]=await Promise.all([
  safeQuery(sb.from('profiles').select('*').order('created_at',{ascending:true})),
  safeQuery(sb.from('player_stats').select('*')),
  safeQuery(sb.from('demons').select('*').order('rank',{ascending:true})),
  safeQuery(sb.from('records').select('*').order('created_at',{ascending:false})),
  safeQuery(sb.from('unlist_submissions').select('*').order('created_at',{ascending:false})),
  safeQuery(sb.from('admin_activity').select('*').order('created_at',{ascending:false}).limit(300)),
  safeQuery(sb.from('player_moderation').select('*').eq('active',true))
 ]);
 const statsBy=new Map(stats.map(x=>[x.user_id,x]));
 db.users=profiles.map(p=>{const st=statsBy.get(p.id)||{};const acts=moderationRows.filter(m=>m.user_id===p.id);return{id:p.id,username:p.username,display:p.username,email:p.id===uidSession?(authUser?.email||''):'',joined:p.created_at,points:st.points||0,hardest:st.hardest||'',bio:p.description||'',avatar:p.avatar_url||'',admin:p.id===uidSession&&currentIsAdmin,hidden:!!st.removed_from_top,suspended:acts.some(m=>m.action==='temporary_suspension'),banned:acts.some(m=>m.action==='permanent_ban')}});
 const userBy=new Map(db.users.map(u=>[u.id,u]));
 db.demons=levelRows.map(d=>({id:d.id,name:d.name,top:d.rank||1,list:d.list_type||'main',creator:d.creator||'',verifier:d.verifier||'',song:d.song||'',levelId:d.level_id||'',verify:d.verification_url||'',cover:d.cover_url||'',description:d.level_url||'',difficulty:d.difficulty||'Extreme Demon',originalTop:d.top_original||'',originalList:'',archived:d.status==='rejected',uploaderId:d.submitted_by||'',uploaderName:userBy.get(d.submitted_by)?.username||d.gd_uploader||'Moderación',submissionStatus:d.status||'approved'}));
 const demonBy=new Map(db.demons.map(d=>[d.id,d]));
 for(const x of unlistRows){if(!db.demons.some(d=>d.id===x.id)){db.demons.push({id:x.id,name:x.level_name,top:0,list:'unlist',creator:x.creator||'',verifier:x.gd_username||'',song:x.song||'',levelId:x.level_id||'',verify:x.verification_url||x.gameplay_url||'',cover:x.cover_url||'',description:'',difficulty:x.difficulty||'Sin verificar',originalTop:'',originalList:'',archived:x.status==='rejected',uploaderId:x.submitted_by||'',uploaderName:userBy.get(x.submitted_by)?.username||x.gd_username||'Comunidad',submissionStatus:x.status||'pending'})}}
 const allDemonBy=new Map(db.demons.map(d=>[d.id,d]));
 db.subs=recordRows.map(r=>{const d=allDemonBy.get(r.demon_id);return{id:r.id,user:r.player_id,player:r.player_name||userBy.get(r.player_id)?.username||'Jugador',top:r.top_position||d?.top||1,name:d?.name||'Nivel',levelId:r.demon_id||'',list:d?.list||'main',cover:d?.cover||'',url:r.video_url||'',comment:r.comment||'',status:statusOut(r.status),at:r.created_at,source:'record'}});
 for(const x of unlistRows){if(!db.subs.some(s=>s.id===x.id)){db.subs.push({id:x.id,user:x.submitted_by||'',player:x.gd_username||userBy.get(x.submitted_by)?.username||'Jugador',top:1,name:x.level_name,levelId:'',list:'unlist',cover:x.cover_url||'',url:x.verification_url||x.gameplay_url||'',comment:'',status:statusOut(x.status),at:x.created_at,source:'unlist'})}}
 db.log=activityRows.map(x=>({id:x.id,action:x.action,target:x.target_id||x.target_type||'Actividad',details:typeof x.details==='string'?x.details:JSON.stringify(x.details||{}),by:userBy.get(x.admin_id)?.username||'Moderación',at:x.created_at}));
 syncState=clone(db);try{localStorage.setItem(KEY,JSON.stringify(db))}catch{}render();populateSubmitSelectors();
}
async function upsertProfile(u){const r=await sb.from('profiles').upsert({id:u.id,username:u.username,avatar_url:u.avatar||null,description:u.bio||'',created_at:u.joined||now()},{onConflict:'id'});if(r.error)throw r.error}
async function upsertDemon(d){if(d.list==='unlist'){const r=await sb.from('unlist_submissions').upsert({id:d.id,level_name:d.name,level_id:d.levelId||'',creator:d.creator||'',gd_username:d.uploaderName||d.verifier||'',cover_url:d.cover||'',difficulty:d.difficulty||'Sin verificar',song:d.song||null,gameplay_url:d.verify||null,verification_url:d.verify||null,submitted_by:d.uploaderId||uidSession,status:d.archived?'rejected':(d.submissionStatus||'pending')},{onConflict:'id'});if(r.error)throw r.error;return}
 const r=await sb.from('demons').upsert({id:d.id,name:d.name,level_id:d.levelId||null,creator:d.creator||null,gd_uploader:d.uploaderName||null,difficulty:d.difficulty||'Extreme Demon',cover_url:d.cover||null,song:d.song||null,list_type:d.list,rank:d.top,status:d.archived?'rejected':'approved',submitted_by:d.uploaderId||uidSession,top_original:Number(d.originalTop)||null,verifier:d.verifier||null,verification_url:d.verify||null,level_url:d.description||null},{onConflict:'id'});if(r.error)throw r.error}
async function syncChanges(){if(!uidSession||!syncState)return;const before=syncState,oldUsers=new Map(before.users.map(x=>[x.id,x])),newUsers=new Map(db.users.map(x=>[x.id,x]));
 for(const [uid,u] of newUsers){const old=oldUsers.get(uid);if(!old||old.username!==u.username||old.bio!==u.bio||old.avatar!==u.avatar||old.joined!==u.joined)await upsertProfile(u);if(admin()&&(!old||old.points!==u.points||old.hardest!==u.hardest||old.hidden!==u.hidden)){const r=await sb.from('player_stats').upsert({user_id:u.id,points:u.points||0,hardest:u.hardest||null,removed_from_top:!!u.hidden,arrival_date:u.joined||now(),updated_at:now()},{onConflict:'user_id'});if(r.error)throw r.error}}
 const oldD=new Map(before.demons.map(x=>[x.id,x])),newD=new Map(db.demons.map(x=>[x.id,x]));
 for(const [did,d] of newD){const old=oldD.get(did);if(!old||!same(old,d)){if(!admin()&&d.list!=='unlist'&&!old)continue;if(old&&old.list!=='unlist'&&d.list==='unlist'){const del=await sb.from('demons').delete().eq('id',did);if(del.error)throw del.error}if(old&&old.list==='unlist'&&d.list!=='unlist'){const upd=await sb.from('unlist_submissions').update({status:'rejected'}).eq('id',did);if(upd.error)throw upd.error}await upsertDemon(d)}}
 for(const [did,d] of oldD){if(!newD.has(did)&&admin()){const r=d.list==='unlist'?await sb.from('unlist_submissions').delete().eq('id',did):await sb.from('demons').delete().eq('id',did);if(r.error)throw r.error}}
 const oldS=new Map(before.subs.map(x=>[x.id,x])),newS=new Map(db.subs.map(x=>[x.id,x]));
